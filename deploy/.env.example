# Generate both secrets locally. Do not commit the populated .env file.
# Dual-mode access. Keep RELAY_SITE=:80 so http://SERVER_IP:HTTP_PORT stays
# available. Set RELAY_DOMAIN after DNS resolves to enable HTTPS automatically.
RELAY_SITE=:80
RELAY_DOMAIN=
# Leave unset. Compose derives the stable project name from this deploy directory.
# COMPOSE_PROJECT_NAME=
HTTP_PORT=39300
HTTPS_PORT=39301
APP_PORT=39200
PLATFORM_VERSION=1.1.0
PUBLIC_BASE_URL=
ADMIN_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DATA_ENCRYPTION_KEY=

POSTGRES_DB=sms_relay
POSTGRES_USER=sms_relay
POSTGRES_PASSWORD=
DATABASE_URL=

RETENTION_DAYS=7
RETENTION_INTERVAL_SECONDS=3600
OTP_TTL_SECONDS=600
DEVICE_COMMAND_PENDING_TTL_SECONDS=600
DEVICE_COMMAND_RESULT_TTL_SECONDS=1800
CLAIMED_OTP_RETENTION_SECONDS=86400
HMAC_SKEW_SECONDS=300

# Optional external MQTT bridge for Air724 SMS upload. Leave blank to keep the
# existing HTTP/WebSocket-only deployment unchanged. Start it with the mqtt
# Compose profile after setting these values.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=sms-relay-mqtt-bridge-relay
MQTT_TRANSPORT=tcp
MQTT_WS_PATH=/websocket
MQTT_TOPIC_FILTER=relay/v1/devices/+/messages
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
RELAY_MQTT_INGEST_URL=http://app:39200/api/v1/ingest/mqtt
RELAY_MQTT_BRIDGE_TOKEN=
