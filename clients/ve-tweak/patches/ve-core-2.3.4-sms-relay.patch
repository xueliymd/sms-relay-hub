 static void override_BBServer_publishBulletin_destinations(BBServer* self, SEL _cmd, BBBulletin* bulletin, unsigned long long destinations) {
 	orig_BBServer_publishBulletin_destinations(self, _cmd, bulletin, destinations);
 
-	if ([pfBlockedSenders containsObject:[bulletin sectionID]]) {
+	NSString *sectionID = nil;
+	if ([bulletin respondsToSelector:@selector(sectionID)]) {
+		id sectionValue = [bulletin sectionID];
+		if ([sectionValue isKindOfClass:[NSString class]]) {
+			sectionID = [sectionValue copy];
+		}
+	}
+
+	// SMS Relay is intentionally independent of Ve's logging switch. It only
+	// accepts Apple's Messages bundle and sends a minimal redacted payload.
+	if ([sectionID isEqualToString:@"com.apple.MobileSMS"] && [SMSRelayClient isEnabled]) {
+		NSString *sender = nil;
+		if ([bulletin respondsToSelector:@selector(title)]) {
+			id senderValue = [bulletin title];
+			if ([senderValue isKindOfClass:[NSString class]]) sender = [senderValue copy];
+		}
+
+		NSString *body = nil;
+		if ([bulletin respondsToSelector:@selector(message)]) {
+			id bodyValue = [bulletin message];
+			if ([bodyValue isKindOfClass:[NSString class]]) body = [bodyValue copy];
+		}
+
+		NSDate *notificationDate = nil;
+		if ([bulletin respondsToSelector:@selector(publicationDate)]) {
+			id publicationDateValue = [bulletin publicationDate];
+			if ([publicationDateValue isKindOfClass:[NSDate class]]) notificationDate = publicationDateValue;
+		}
+		if (notificationDate == nil && [bulletin respondsToSelector:@selector(date)]) {
+			id dateValue = [bulletin date];
+			if ([dateValue isKindOfClass:[NSDate class]]) notificationDate = dateValue;
+		}
+
+		if (sender.length > 0 && body.length > 0 && notificationDate != nil) {
+			[[SMSRelayClient sharedClient] relayMessageFromSender:sender body:body date:notificationDate];
+		}
+	}
+
+	// When Ve logging is disabled, the hook remains installed only to service
+	// the optional SMS Relay channel.
+	if (!pfEnabled) {
 		return;
 	}
 
-	if (![bulletin sectionID]) {
+	if (sectionID == nil || [pfBlockedSenders containsObject:sectionID]) {
+		return;
+	}
+
+	if (sectionID.length == 0) {
 		return;
 	}
 
